{
  "datasource": {
    "name": "gscpi",
    "description": "FRBNY GSCPI (Global Supply Chain Pressure Index)"
  },
  "period_column": "date",
  "period_format": "%Y-%m-%d",
  "time_grain": "M",
  "category": {
    "name": "supply_chain_pressure",
    "category_0": "market_macro",
