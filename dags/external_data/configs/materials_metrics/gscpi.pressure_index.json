  },
  "metrics": [
    {
      "match": {
        "series": "GSCPI"
      },
      "measure_column": "value",
      "name": "gscpi_pressure_index",
      "description": "글로벌 공급망 압력 지수 (월별, 표준편차)",
      "unit": "std_dev"
    }
  ]
}
