{
  "scrape": {
    "recipe": "eia.series",
    "params": {
      "series_id": "PET.RBRTE.D"
    }
  },
  "datasource": {
    "name": "eia",
    "description": "U.S. Energy Information Administration (EIA)"
  },
  "period_column": "period",
  "period_format": "%Y-%m-%d",
  "time_grain": "D",
  "category": {
    "name": "energy_petroleum_price",
    "category_0": "energy",
    "category_1": "petroleum",
    "description": "에너지 - 석유 - 가격",
    "category_2": "price"
  },
  "metrics": [
    {
      "match": {
        "series": "RBRTE"
      },
      "measure_column": "value",
      "name": "brent_spot_daily",
      "description": "유럽 브렌트 현물가격 (일별)",
      "unit": "$/BBL"
    }
  ]
}
