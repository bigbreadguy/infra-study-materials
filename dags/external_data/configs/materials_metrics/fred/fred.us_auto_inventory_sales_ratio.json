{
  "scrape": {
    "recipe": "fred.series",
    "params": {
      "series_id": "AISRSA"
    }
  },
  "datasource": {
    "name": "fred",
    "description": "Federal Reserve Economic Data (FRED)"
  },
  "period_column": "date",
  "period_format": "%Y-%m-%d",
  "time_grain": "M",
  "category": {
    "name": "automotive",
