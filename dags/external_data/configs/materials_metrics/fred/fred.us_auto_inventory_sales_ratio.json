    "category_1": "automotive",
    "description": "제조업 - 자동차"
  },
  "metrics": [
    {
      "match": {
        "series_id": "AISRSA"
      },
      "measure_column": "value",
      "name": "us_auto_inventory_sales_ratio",
      "description": "미국 자동차 재고/판매 비율 (계절조정 SA, 월별)",
      "unit": "ratio"
    }
  ]
