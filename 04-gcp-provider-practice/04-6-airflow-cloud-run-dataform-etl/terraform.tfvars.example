project_id = "example-study-proj"

# Set these to true only after completing the earlier GCP safety lessons.
billing_budget_confirmed = false
adc_credentials_reviewed = false
remote_state_reviewed    = false

region              = "us-central1"
bq_location         = "us-central1"
raw_bucket_location = "us-central1"
environment         = "dev"
owner               = "kenny"

extra_labels = {
  curriculum = "terraform_basics"
}

# Terraform creates this repository, but it does not build or push images.
# Replace the placeholder after pushing a real non-secret worker image.
scraper_image = "us-central1-docker.pkg.dev/example-study-proj/dev-etl-workers/scraper:replace-with-tag"

# Grant these only to the local user, group, or runner that truly needs them.
airflow_impersonators = [
  "user:replace-with-your-google-account@example.com",
]

terraform_deployer_principals = [
  "user:replace-with-your-google-account@example.com",
]

raw_object_retention_days        = 30
raw_bucket_versioning_enabled    = true
force_destroy_raw_bucket         = false
delete_bigquery_contents_on_destroy = false
bigquery_table_deletion_protection  = false

scraper_task_count    = 1
scraper_parallelism   = 1
scraper_task_timeout  = "1800s"
scraper_max_retries   = 1
scraper_cpu           = "1"
scraper_memory        = "2Gi"
scrape_schema_version = "v1"
scraper_output_format = "ndjson.gz"

# Keep real action plans in ignored local files, private GCS, or another
# private release path. This placeholder is intentionally non-functional.
default_action_plan_uri = "gs://example-bucket/action-plan.json"

# Enable only when the scraper target requires credentials. Terraform creates
# secret metadata and IAM only; add secret versions outside Terraform.
enable_scraper_credentials_secret        = false
attach_scraper_credentials_secret_to_job = false

# The default path uses Airflow BigQuery load operators. Enable this only if
# load/normalization needs custom container code.
enable_loader_job = false
loader_image      = ""

dataform_git_commitish  = "main"
dataform_included_tags  = ["etl"]
airflow_dataform_repository_role = "roles/dataform.editor"
